# job_extractor environment configuration
# All settings are OPTIONAL — the tool runs with defaults when unset.
# Copy to `.env` (git-ignored) if you need to override anything.

# Debug: enable secret-safe diagnostic trace for detail resolution (writes to /tmp)
STEP94H_DEBUG=0

# Debug: stop detail pipeline after first job (troubleshooting aid)
STEP94H_STOP_AFTER_FIRST=0

# Debug: emit redacted discovery and scope timing traces for one run.
# Do not publish trace output without reviewing it first.
JOB_EXTRACTOR_TRACE=0

# Backward-compatible internal timing switch. Prefer JOB_EXTRACTOR_TRACE.
STEP95G_TIMING=0

# Runtime: detail API concurrency override (integer, clamped to 1-8)
DETAIL_API_CONCURRENCY=5
