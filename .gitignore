# Generated reports / output.
# The repository tracks only the fixed runtime directory skeleton
# (output/.gitkeep, output/_failed/.gitkeep, output/_unknown/.gitkeep —
# constants UNKNOWN/FAILED_ROOT in job_extractor/output_layout.py).
# Every real run result (company dirs, timestamp dirs, jobs.json/xlsx/csv/
# report.md, error_report.json) stays ignored.
outputs/
artifacts/
/output/*
!/output/.gitkeep
!/output/_failed/
/output/_failed/*
!/output/_failed/.gitkeep
!/output/_unknown/
/output/_unknown/*
!/output/_unknown/.gitkeep

# Excel temporary files
~$*.xlsx

# Playwright/browser cache
.playwright/

# Local database / runtime storage
*.db
*.sqlite
*.sqlite3

# Project reconstruction snapshots
job_extractor_canonical_reconstructed_*/
job_extractor_step*_ready_*/

# Historical step artifacts
.step*/
.test-runs/
.step*_full_before.txt
